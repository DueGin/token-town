# 复制为 .env 后填写。.env 不要提交到仓库。

# 必填：至少 32 个字符，用来签发后台会话、加密保存的数据库密码（openssl rand -base64 36）
TOWN_SECRET=

# 控制后台密码；留空时后台不可用，小镇照常运行
ADMIN_PASSWORD=

# PORT=3200
# HOST=0.0.0.0
# DATA_DIR=./data
# COOKIE_SECURE=true
# TRUST_PROXY=true

# 可选：仅在第一次启动、还没有 data/config.json 时预填 Sub2API 数据源；之后以后台配置为准
# SUB2API_DATABASE_HOST=postgres
# SUB2API_DATABASE_PORT=5432
# SUB2API_DATABASE_DBNAME=sub2api
# SUB2API_DATABASE_USER=token_town
# SUB2API_DATABASE_PASSWORD=
# SUB2API_DATABASE_SSLMODE=disable
